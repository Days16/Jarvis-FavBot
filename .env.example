# ── Bot principal ─────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# ── Base de datos (Supabase) ──────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── IA OpenRouter ─────────────────────────────────────────
